{
  "name": "margin-pi",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx scripts/start-margin.ts --dev",
    "build": "tsc --noEmit && vite build && tsx scripts/build-recovery.ts",
    "history": "tsx scripts/checkpoint-cli.ts",
    "start": "tsx scripts/start-margin.ts",
    "start:sandbox": "tsx scripts/start-margin.ts",
    "start:native": "NODE_ENV=production tsx scripts/start-native.ts",
    "dev:native": "tsx watch scripts/start-native.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --config tests/project-notes.playwright.config.ts",
    "check": "npm run test && npm run build",
    "probe": "tsx scripts/probe.ts",
    "test:sandbox": "tsx scripts/check-cco.ts",
    "start:single-sandbox": "tsx scripts/start-cco.ts",
    "test:gateway": "playwright test --config tests/gateway.playwright.config.ts",
    "pi": "tsx scripts/local-pi.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "typebox": "^1.3.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
